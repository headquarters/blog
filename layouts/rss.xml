{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title>
    <description>{{ .Site.Params.description }}</description>
    <link>{{ .Site.BaseURL }}</link>
    <atom:link href="{{ "feed.xml" | absURL }}" rel="self" type="application/rss+xml"/>
    <pubDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    <generator>Hugo</generator>
    {{ range first 10 (where .Site.RegularPages "Section" "posts").ByDate.Reverse }}
      <item>
        <title>{{ .Title }}</title>
        <description>{{ htmlEscape .Content | safeHTML }}</description>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
        <link>{{ .Permalink }}</link>
        <guid isPermaLink="true">{{ .Permalink }}</guid>
        {{ range .Params.tags }}
        <category>{{ . }}</category>
        {{ end }}
      </item>
    {{ end }}
  </channel>
</rss>
